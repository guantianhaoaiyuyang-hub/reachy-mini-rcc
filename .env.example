# Reachy Mini RCC - Doubao example configuration
#
# NEVER commit real credentials.
#
# The installed RCC stores sensitive values in Windows Credential Manager.
# This file exists only as a development reference.

DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_APP_ID=YOUR_APP_ID
DOUBAO_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
DOUBAO_APP_KEY=YOUR_APP_KEY
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_MODEL=YOUR_MODEL
