# Normalize text files in the repository
* text=auto

# Source and documentation
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf

# Windows-oriented scripts / installer files
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf
*.iss  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.onnx binary
*.pt   binary
*.pth  binary